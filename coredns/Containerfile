FROM quay.io/hummingbird/core-runtime:2.42-builder@sha256:8f23f91039f121b95d5f4aaa928885afc86ffbf0bb6b15113a440c7bf2c13d26 AS builder

ARG VERSION=1.14.4

USER 0
RUN dnf install -y tar gzip && \
  curl -L https://github.com/coredns/coredns/releases/download/v${VERSION}/coredns_${VERSION}_linux_amd64.tgz | tar zxvf - && \
  ls -al coredns

FROM quay.io/hummingbird/core-runtime:2.42@sha256:b93bfca801245219c332093e1c52a639414154533cecb1522630aeef48710960

COPY --from=builder /tmp/coredns /usr/local/bin/coredns

WORKDIR /etc/coredns
ENTRYPOINT ["coredns"]
