# Build stage
FROM quay.io/hummingbird/nodejs:26-builder@sha256:0d0de7150b23a6d4538b58b63d4a2fd739f0bb820022d8ae77871101d81a308a AS builder

ARG VERSION=17.10.0

# Install jq + deps
USER root
RUN dnf install -y jq && \
  dnf clean all -y

# Runtime stage
FROM quay.io/hummingbird/nodejs:26@sha256:780083bc3e8a0d9fe4d7283069d39cb17b15f0f03c95ee1fa8e9eaa9bc125452

USER root
RUN npm i release-please@${VERSION} -g && \
  release-please --version
USER ${CONTAINER_DEFAULT_USER}

# Copy jq + deps from builder
COPY --from=builder /usr/bin/jq /usr/bin/jq
COPY --from=builder /usr/lib64/libjq* /usr/lib64/
COPY --from=builder /usr/lib64/libonig* /usr/lib64/

ENTRYPOINT ["release-please"]
