# Build stage
FROM quay.io/hummingbird/nodejs:26-builder@sha256:d06adaf380183b6b8fedb7029fb5bead97a3c32eae7642dc3f83498d42066044 AS builder

ARG VERSION=17.11.0

# Install jq + deps
USER root
RUN dnf install -y jq && \
  dnf clean all -y

# Runtime stage
FROM quay.io/hummingbird/nodejs:26@sha256:1069c60407033e867e36e72830945c570242bf75c6adfb1c31a2371b3747e736

USER root
RUN npm i release-please@${VERSION} -g && \
  release-please --version
USER ${CONTAINER_DEFAULT_USER}

# Copy jq + deps from builder
COPY --from=builder /usr/bin/jq /usr/bin/jq
COPY --from=builder /usr/lib64/libjq* /usr/lib64/
COPY --from=builder /usr/lib64/libonig* /usr/lib64/

ENTRYPOINT ["release-please"]
