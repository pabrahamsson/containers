# Build stage
FROM quay.io/hummingbird/nodejs:26-builder@sha256:608c2ce5b7775f36b5c985823a8d52f62bd7c234b1a70a464ac826f1b89b62a7 AS builder

ARG VERSION=17.10.0

# Install jq + deps
USER root
RUN dnf install -y jq && \
  dnf clean all -y

# Runtime stage
FROM quay.io/hummingbird/nodejs:26@sha256:feaa82bd299588bebc37594159aa4fe3299d4f8f6899925aea195962c5360eff

USER root
RUN npm i release-please@${VERSION} -g && \
  release-please --version
USER ${CONTAINER_DEFAULT_USER}

# Copy jq + deps from builder
COPY --from=builder /usr/bin/jq /usr/bin/jq
COPY --from=builder /usr/lib64/libjq* /usr/lib64/
COPY --from=builder /usr/lib64/libonig* /usr/lib64/

ENTRYPOINT ["release-please"]
